# Firebase console → Project settings → Your apps → Web app → SDK setup and configuration.
# These values are public by design (they identify the project); security comes from firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to true after enabling the GitHub provider in Firebase Authentication.
NEXT_PUBLIC_ENABLE_GITHUB_SIGNIN=false

# Optional: the public address once you have a custom domain. On Vercel the production URL is used automatically.
NEXT_PUBLIC_SITE_URL=
